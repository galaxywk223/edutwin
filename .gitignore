modeling/dist/
.coverage
.coverage.*
htmlcov/

# Generated and restricted datasets
data/raw/**
!data/raw/**/
!data/raw/**/.gitkeep
data/interim/**
!data/interim/**/
!data/interim/**/.gitkeep
data/processed/**
!data/processed/**/
!data/processed/**/.gitkeep
data/demo/generated/**
!data/demo/generated/**/
!data/demo/generated/**/.gitkeep

# Generated model artifacts; metadata remains trackable
modeling/artifacts/**
!modeling/artifacts/**/
!modeling/artifacts/**/.gitkeep
!modeling/artifacts/**/*.json
!modeling/artifacts/**/*.yaml
!modeling/artifacts/**/*.yml
!modeling/artifacts/**/*.md

# Generated report exports
reports/dist/**
!reports/dist/.gitkeep

# Model binaries outside the artifact registry
*.bin
*.pt
*.pth
*.ckpt
*.onnx
*.pkl
*.pickle
*.joblib
*.model
*.cbm
*.safetensors

# Empty directory markers are always tracked
!.gitkeep
