{
  "name": "edutwin-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:showcase": "node scripts/generate-showcase.mjs && vite --host 0.0.0.0 --mode showcase",
    "build": "vue-tsc -b && vite build",
    "build:showcase": "node scripts/generate-showcase.mjs && vue-tsc -b && vite build --mode showcase",
    "generate:showcase": "node scripts/generate-showcase.mjs",
    "typecheck": "vue-tsc -b --pretty false",
    "test": "vitest run --coverage=false",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "@lucide/vue": "^1.24.0",
    "dompurify": "^3.4.12",
    "echarts": "^5.6.0",
    "element-plus": "^2.11.0",
    "marked": "^18.0.6",
    "pinia": "^3.0.3",
    "vue": "^3.5.18",
    "vue-echarts": "^7.0.3",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@types/node": "^24.2.1",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/test-utils": "^2.4.6",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.2",
    "vitest": "^3.2.4",
    "vue-tsc": "^3.0.5"
  },
  "engines": {
    "node": ">=22"
  }
}
