{
  "name": "edutwin-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:showcase": "node scripts/generate-showcase.mjs && vite --host 0.0.0.0 --mode showcase",
    "build": "vue-tsc -b && vite build",
    "build:showcase": "node scripts/generate-showcase.mjs && vue-tsc -b && vite build --mode showcase",
    "generate:showcase": "node scripts/generate-showcase.mjs",
    "typecheck": "vue-tsc -b --pretty false",
    "test": "vitest run --coverage=false",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "@lucide/vue": "^1.39.0",
    "dompurify": "^3.4.14",
    "echarts": "^6.1.0",
    "element-plus": "^2.14.5",
    "marked": "^18.0.11",
    "pinia": "^4.0.3",
    "vue": "^3.5.42",
    "vue-echarts": "^8.2.0",
    "vue-router": "^5.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.5.0",
    "jsdom": "^30.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.3.11"
  },
  "engines": {
    "node": ">=22"
  }
}
