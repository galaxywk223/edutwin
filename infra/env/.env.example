# Compose identity and frozen image coordinates. Local defaults use local images;
# the server deployment script rewrites the repositories to private GHCR packages.
COMPOSE_PROJECT_NAME=edutwin
EDUTWIN_IMAGE_TAG=local
EDUTWIN_VCS_REF=unknown
EDUTWIN_BACKEND_IMAGE=edutwin/backend
EDUTWIN_MODEL_IMAGE=edutwin/model-service
EDUTWIN_FRONTEND_IMAGE=edutwin/frontend
EDUTWIN_MODEL_DEPLOYMENT_MODE=active
EDUTWIN_SITE_ADDRESS=http://localhost

# MySQL and Redis credentials. Replace every CHANGE_ME value before startup.
MYSQL_DATABASE=edutwin
MYSQL_USER=edutwin
MYSQL_PASSWORD=CHANGE_ME_DATABASE_PASSWORD
MYSQL_ROOT_PASSWORD=CHANGE_ME_ROOT_PASSWORD
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

# HS256 requires at least 32 bytes. Use a cryptographically random value.
EDUTWIN_JWT_SECRET=CHANGE_ME_WITH_AT_LEAST_32_RANDOM_BYTES

# The first system administrator is created idempotently during backend startup.
EDUTWIN_ADMIN_USERNAME=admin
EDUTWIN_ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD_AT_LEAST_16_CHARACTERS
EDUTWIN_ADMIN_DISPLAY_NAME=System Administrator

# Synthetic demo identities are created by the database importer.
EDUTWIN_DEMO_IMPORT_ENABLED=true
EDUTWIN_DEMO_AS_OF=
EDUTWIN_DEMO_TEACHER_PASSWORD=CHANGE_ME_DEMO_TEACHER_PASSWORD
EDUTWIN_DEMO_STUDENT_PASSWORD=CHANGE_ME_DEMO_STUDENT_PASSWORD

# The OpenAI-compatible fallback remains disabled by default.
EDUTWIN_AI_ENABLED=false
EDUTWIN_AI_FORCE_TIMEOUT=false
EDUTWIN_AI_TIMEOUT=PT2S
EDUTWIN_AI_CONFIGURATION_TEST_TIMEOUT=PT20S
EDUTWIN_AI_CONFIG_ENCRYPTION_KEY=CHANGE_ME_BASE64_32_BYTE_KEY
EDUTWIN_AI_ALLOW_INSECURE_BASE_URL=false
EDUTWIN_LLM_API_KEY=disabled
EDUTWIN_LLM_BASE_URL=https://api.deepseek.com
EDUTWIN_LLM_MODEL=deepseek-v4-flash
# Legacy aliases remain supported for existing deployments.
DEEPSEEK_API_KEY=disabled
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# Required only when downloading the restricted ASSISTments source.
EDUTWIN_ASSISTMENTS_DOWNLOAD_URL=
