{
	admin off
}

:8080 {
	encode zstd gzip

	header {
		-Server
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
	}

	handle /healthz {
		respond "ok" 200
	}

	handle /api/* {
		reverse_proxy showcase-api:8080 {
			flush_interval -1
		}
	}

	handle {
		reverse_proxy frontend:8080
	}
}
