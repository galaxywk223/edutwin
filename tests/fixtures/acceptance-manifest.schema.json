{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://edutwin.local/schemas/acceptance-manifest-v1.json",
  "title": "EduTwin delivery acceptance manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "runId",
    "target",
    "status",
    "startedAt",
    "endedAt",
    "codeTree",
    "pythonEnvironment",
    "data",
    "models",
    "images",
    "migrations",
    "results",
    "gates",
    "requirements",
    "local",
    "server",
    "openItems"
  ],
  "properties": {
    "schemaVersion": { "const": 2 },
    "kind": { "const": "edutwin-delivery-acceptance" },
    "runId": { "type": "string", "pattern": "^[0-9]{8}T[0-9]{9}Z$" },
    "target": { "enum": ["Local", "Server", "All"] },
    "status": { "enum": ["PASSED", "FAILED"] },
    "startedAt": { "type": "string", "format": "date-time" },
    "endedAt": { "type": "string", "format": "date-time" },
    "codeTree": { "$ref": "#/definitions/hashReference" },
    "pythonEnvironment": { "$ref": "#/definitions/pythonEnvironment" },
    "data": { "$ref": "#/definitions/dataEvidence" },
    "models": { "$ref": "#/definitions/modelEvidence" },
    "images": {
      "type": "array",
      "items": { "$ref": "#/definitions/imageEvidence" }
    },
    "migrations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["local", "server"],
      "properties": {
        "local": {
          "type": "array",
          "items": { "$ref": "#/definitions/migrationEvidence" }
        },
        "server": {
          "type": "array",
          "items": { "$ref": "#/definitions/migrationEvidence" }
        }
      }
    },
    "results": { "$ref": "#/definitions/verificationResults" },
    "gates": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/gate" }
    },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/requirement" }
    },
    "local": { "$ref": "#/definitions/scopeResult" },
    "server": { "$ref": "#/definitions/scopeResult" },
    "openItems": {
      "type": "array",
      "items": { "$ref": "#/definitions/openItem" }
    }
  },
  "definitions": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "hashReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "sha256"],
      "properties": {
        "algorithm": { "const": "SHA-256" },
        "sha256": { "$ref": "#/definitions/sha256" }
      }
    },
    "fileReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "bytes", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "bytes": { "type": "integer", "minimum": 0 },
        "sha256": { "$ref": "#/definitions/sha256" }
      }
    },
    "nullableFileReference": {
      "anyOf": [
        { "$ref": "#/definitions/fileReference" },
        { "type": "null" }
      ]
    },
    "pythonEnvironment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "recordPath", "selectionKind", "command", "workingDirectory"],
      "properties": {
        "status": { "enum": ["CONFIRMED", "UNCONFIRMED"] },
        "recordPath": { "type": "string", "minLength": 1 },
        "selectionKind": { "type": ["string", "null"] },
        "command": { "type": ["string", "null"] },
        "workingDirectory": { "type": ["string", "null"] }
      }
    },
    "dataEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceLock", "processingManifest", "reproducibilityGate", "datasets"],
      "properties": {
        "sourceLock": { "$ref": "#/definitions/nullableFileReference" },
        "processingManifest": { "$ref": "#/definitions/nullableFileReference" },
        "reproducibilityGate": { "type": "string", "minLength": 1 },
        "datasets": {
          "type": "array",
          "items": { "$ref": "#/definitions/datasetEvidence" }
        }
      }
    },
    "datasetEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceId", "version", "manifestSha256", "sourceSha256s"],
      "properties": {
        "sourceId": {
          "enum": [
            "ASSISTMENTS_2009_2010_SKILL_BUILDER_CORRECTED",
            "OULAD",
            "EDUTWIN_DEMO"
          ]
        },
        "version": { "type": "string", "minLength": 1 },
        "manifestSha256": { "$ref": "#/definitions/sha256" },
        "sourceSha256s": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/definitions/sha256" }
        }
      }
    },
    "modelEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "knowledgeFreeze",
        "knowledgeTestMetrics",
        "riskFreeze",
        "riskTestMetrics",
        "artifacts",
        "versions",
        "testEvaluations"
      ],
      "properties": {
        "knowledgeFreeze": { "$ref": "#/definitions/nullableFileReference" },
        "knowledgeTestMetrics": { "$ref": "#/definitions/nullableFileReference" },
        "riskFreeze": { "$ref": "#/definitions/nullableFileReference" },
        "riskTestMetrics": { "$ref": "#/definitions/nullableFileReference" },
        "artifacts": {
          "type": "array",
          "items": { "$ref": "#/definitions/fileReference" }
        },
        "versions": {
          "type": "array",
          "items": { "$ref": "#/definitions/modelVersionEvidence" }
        },
        "testEvaluations": {
          "type": "array",
          "items": { "$ref": "#/definitions/testEvaluationEvidence" }
        }
      }
    },
    "metricEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "value"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "value": { "type": "number" }
      }
    },
    "modelVersionEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task", "family", "modelVersion", "selected", "artifactSha256s", "metrics"
      ],
      "properties": {
        "task": { "enum": ["KNOWLEDGE", "RISK"] },
        "family": {
          "enum": ["IRT", "BKT", "DKT", "AKT", "LOGISTIC_REGRESSION", "LIGHTGBM", "CATBOOST"]
        },
        "modelVersion": { "type": "string", "minLength": 1 },
        "selected": { "type": "boolean" },
        "artifactSha256s": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/definitions/sha256" }
        },
        "metrics": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/metricEvidence" }
        }
      }
    },
    "testEvaluationEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task", "freezeManifestSha256", "testSetKind", "testSetSha256"],
      "properties": {
        "task": { "enum": ["KNOWLEDGE", "RISK"] },
        "freezeManifestSha256": { "$ref": "#/definitions/sha256" },
        "testSetKind": { "enum": ["EVENTS", "STUDENTS"] },
        "testSetSha256": { "$ref": "#/definitions/sha256" }
      }
    },
    "resultScope": {
      "type": "object",
      "additionalProperties": { "$ref": "#/definitions/nullableFileReference" }
    },
    "verificationResults": {
      "type": "object",
      "additionalProperties": false,
      "required": ["local", "server"],
      "properties": {
        "local": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "liveContracts", "closedLoop", "deepSeekToolCall", "resilience",
            "performance", "restartRecovery", "modelRollback", "runtime"
          ],
          "properties": {
            "liveContracts": { "$ref": "#/definitions/nullableFileReference" },
            "closedLoop": { "$ref": "#/definitions/nullableFileReference" },
            "deepSeekToolCall": { "$ref": "#/definitions/nullableFileReference" },
            "resilience": { "$ref": "#/definitions/nullableFileReference" },
            "performance": { "$ref": "#/definitions/nullableFileReference" },
            "restartRecovery": { "$ref": "#/definitions/nullableFileReference" },
            "modelRollback": { "$ref": "#/definitions/nullableFileReference" },
            "runtime": { "$ref": "#/definitions/nullableFileReference" }
          }
        },
        "server": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "boundary", "liveContracts", "closedLoop", "performance",
            "restartRecovery", "rollback", "runtime"
          ],
          "properties": {
            "boundary": { "$ref": "#/definitions/nullableFileReference" },
            "liveContracts": { "$ref": "#/definitions/nullableFileReference" },
            "closedLoop": { "$ref": "#/definitions/nullableFileReference" },
            "performance": { "$ref": "#/definitions/nullableFileReference" },
            "restartRecovery": { "$ref": "#/definitions/nullableFileReference" },
            "rollback": { "$ref": "#/definitions/nullableFileReference" },
            "runtime": { "$ref": "#/definitions/nullableFileReference" }
          }
        }
      }
    },
    "imageEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope", "name", "id", "platform"],
      "properties": {
        "scope": { "enum": ["Local", "Server"] },
        "name": { "type": "string", "minLength": 1 },
        "id": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "platform": { "const": "linux/amd64" }
      }
    },
    "migrationEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope", "version", "description", "checksum", "installedOn", "success"],
      "properties": {
        "scope": { "enum": ["Local", "Server"] },
        "version": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "checksum": { "type": "integer" },
        "installedOn": { "type": "string", "minLength": 1 },
        "success": { "const": true }
      }
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "category",
        "scope",
        "required",
        "status",
        "startedAt",
        "endedAt",
        "durationMs",
        "exitCode",
        "command",
        "evidence",
        "message"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]+$" },
        "category": { "type": "string", "minLength": 1 },
        "scope": { "enum": ["Shared", "Local", "Server"] },
        "required": { "const": true },
        "status": { "enum": ["PASSED", "FAILED"] },
        "startedAt": { "type": "string", "format": "date-time" },
        "endedAt": { "type": "string", "format": "date-time" },
        "durationMs": { "type": "integer", "minimum": 0 },
        "exitCode": { "type": "integer" },
        "command": { "type": "string", "minLength": 1 },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "message": { "type": "string" }
      }
    },
    "requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "required", "gateIds", "status"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Z]+-[0-9]{3}$" },
        "required": { "const": true },
        "gateIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "status": { "enum": ["PASSED", "FAILED"] }
      }
    },
    "scopeResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requested", "status", "gateIds", "evidence"],
      "properties": {
        "requested": { "type": "boolean" },
        "status": { "enum": ["PASSED", "FAILED", "NOT_REQUESTED"] },
        "gateIds": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "evidence": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "openItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "scope", "message", "evidence"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]+$" },
        "scope": { "enum": ["Shared", "Local", "Server"] },
        "message": { "type": "string", "minLength": 1 },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
